{
  "manifest_version": 3,
  "name": "YouTube Focus Mode",
  "version": "1.2.0",
  "description": "Use YouTube intentionally. Toggle off Shorts, recommendations, autoplay, and other distraction patterns — on your terms, entirely local.",
  "author": "Saurabh Maurya",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "YouTube Focus Mode"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": ["detect.js", "storage.js", "content.js"],
      "css": ["styles/injected.css"],
      "run_at": "document_start"
    }
  ]
}
